# Copy this file to .env and insert your free Gemini API key:
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Active Gemini Model
GEMINI_MODEL=gemini-3.5-flash

# Optional: NYC Open Data app token raises Socrata rate limits (not required)
SOCRATA_APP_TOKEN=

# Cache LLM responses on disk to prevent quota exhaustion on reruns
LLM_CACHE=1

# Backend selection: "gemini" (default) or "local" (OpenAI-compatible llama-server)
LLM_BACKEND=gemini
